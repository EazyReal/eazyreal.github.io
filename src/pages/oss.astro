---
import ArticleLayout from "../layouts/ArticleLayout.astro";
import { ossGroups, ossPrSummary, pageMeta } from "../data/siteContent";

const frontmatter = pageMeta.oss;
---

<ArticleLayout frontmatter={frontmatter}>
  <p>
    Selected work from <strong>{ossPrSummary}</strong> across nine RL, agent infrastructure, and LLM serving repositories.
    I am an <a href="https://github.com/areal-project/AReaL/issues/1652">AReaL repository collaborator</a>.
    Counts verified on October 13, 2026; links below show all merged PRs alongside selected highlights.
  </p>

  {
    ossGroups.map((group) => (
      <>
        <h2 id={group.id}>{group.name}</h2>
        <p><a href={group.mergedPrsHref}>{group.mergedPrCount} merged {group.mergedPrCount === 1 ? "PR" : "PRs"}</a></p>
        <ul>
          {
            group.contributions.map((contribution) => (
              <li>
                <a href={contribution.href}>{contribution.title}</a> - {contribution.description}
              </li>
            ))
          }
        </ul>
      </>
    ))
  }
</ArticleLayout>
